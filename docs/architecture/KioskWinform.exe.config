    <!--C:\ICS\HiDok\asset\kiosk antrian.gif-->
    <add key="GifSep" value="C:\ICS\HiDok\asset\kiosk sep.gif" />
    <!--C:\ICS\HiDok\asset\kiosk sep.gif-->
    <add key="PrinterResumeMedis" value="" />
    <!--HP LaserJet M101-M106  resume medis pasien BPJS, kosongi jika tidak mencetak-->
    <add key="TemplateResumeMedis" value="C:\\ICS\HiDok\asset\resumemedis.xlt" />
    <!--C:\ICS\HiDok\asset\resumemedis.xlt, template resume medis BPJS, kosongi jika tidak ada-->
    <add key="TemplateSEP" value="" />
    <!--C:\ICS\HiDok\asset\sep_casemix.xlt, template sep casemix, kosongi jika tidak ada-->
    <!--=============================================================================================-->
    <add key="KodeTipeJaminanBpjs" value="07101A;07201" />
    <!--tipe jaminan BPJS PBI, gunakan separator ; untuk multiple kode-->
    <add key="KodeTipeJaminanBpjsNonPbi" value="02001" />
    <!--tipe jaminan BPJS Non PBI, gunakan separator ; untuk multiple kode-->
    <add key="KodeTipeJaminanNonBpjs" value="00000" />
    <add key="NamaTipeJaminanNonBpjs" value="Umum / Asuransi Lain" />
    <add key="HideTipeJaminanLain1" value="true" />
    <!--jika ingin disembunyikan, isikan "true", jika tidak, dikosongi-->
    <add key="KodeTipeJaminanLain1" value="" />
    <!-- |pwd:tipe jaminan pemkab grobogan 02601| -->
    <add key="NamaTipeJaminanLain1" value="" />
    <!-- |pwd:tipe jaminan pemkab grobogan| -->
    <add key="NamaTipeJaminanLainEng1" value="" />
    <!-- |pwd:tipe jaminan pemkab grobogan| -->
    <add key="HideJaminanLainAsing" value="true" />
    <!--jika ingin disembunyikan, isikan "true", jika tidak, dikosongi-->
    <add key="KodeTipeJaminanAsing" value="" />
    <add key="MappingLayananJaminan" value="00111 02601;00112 02601;" />
    <!--khusus untuk mapping layanan tertentu dg jaminan tetentu, formatnya "kodeLayanan [spasi] kodetipeJaminan;" |pwd:layanan CST dan VCT dengan jaminan pemkab grobogan|, kosongi jika tidak ada -->
    <add key="MappingLayananKarcis" value="00025 25;00111 21;00112 16;" />
    <!--khusus untuk maping layanan tertentu dg karcis tertentu, formatnya "kodeLayanan [spasi] kodeKarcis;" |pwd:layanan CST dan VCT dengan karcis masing2|, kosongi jika tidak ada -->
    <add key="MappingJmnLayananKarcis" value="00000 00025 25;02001 00025 25;" />
    <!--khusus untuk mapping tipe jaminan tertentu di lyn tertentu dg karcis tertentu, formatnya "kode tipe jaminan [spasi] kodeLayanan [spasi] kodeKarcis;", kosongi jika tidak dipakai -->
    <add key="LayanansFinger" value="2RJ18" />
    <!--Finger BPJS format: "kodelayanan1;kodelayanan2;" dst tanpa spasi-->
    <add key="KodeCaraMasukDkBpjs" value="4" />
    <!--Kode Cara Masuk DK default jika kode ppk belum diisi di ta_rujukan-->
    <!--=============================================================================================-->
    <!--Antrian Daftar defult ada 3, jika dipakai 2, isian bisa disamakan dengan yg digabung antriannya-->
    <add key="KodeLayananPendaftaran" value="" />
    <add key="KodeLayananPendaftaranAsr" value="" />
    <add key="KodeLayananPendaftaranAsrLain" value="" />
    <add key="AntrianIDUmum" value="A" />
    <add key="AntrianIDAsr" value="GLOBAL B; LYN32 C;" />
    <!--ada 2 cara set AntrianIDAsr, [1] seperti biasa hanya satu huruf aja value nya, eg "B"; [2] di-mapping jika antriannya dipecah, GLOBAL antrianID; kode_layanan antrianID;eg: "GLOBAL B; LYN32 C;" -->
    <add key="AntrianIDAsrLain" value="B" />
    <add key="KodePetugasPendaftaran" value="KIOSK" />
    <!--default kodenya KIOSK-->
    <add key="KioskID" value="1" />
    <!--jika ada > 1 kiosk (pendaftaran/farmasi dll) default = 1 -->
    <add key="MaxTimeCheckIn" value="0" />
    <!--masimal waktu pelayanan pasien booking sebelum jam mulai praktek (dalam satuan menit) -->
    <add key="RejectOverJamPraktek" value="0" />
    <!--0 : disable, 1 : enable -> jika pasien booking datang setelah jam praktek dokter dimulai) -->
    <!--=============================================================================================-->
    <add key="KodeKarcisRJ" value="24" />
    <!--default, jika tidak perlu di-set, maka KodeKarcisRJxxxx samakan isinya dengan default ini-->
    <add key="KodeKarcisBPJSRJ" value="24" />
    <!--=============================================================================================-->
    <!--Kasus Purwodadi, jika tidak diperlukan, dikosongi-->
    <add key="KodeKarcisRJLab" value="08" />
    <add key="KodeKarcisRJRegUlangUmum" value="10" />
    <!--pasien umum yg balik lagi, biasanya tinggal ambil obat saja-->
    <add key="KodeKarcisRJKonsulSpesialis" value="22" />
    <!--pasien bpjs yg balik lagi untuk kontrol karena mungkin belum tuntas di kunjungan sebelumnya-->
    <add key="KodeKarcisRJKontrolFree" value="07" />
    <!--pasien layanan yg kontrol lagi, seperti di fisioterapi, karcisnya free -->
    <add key="KodeLayananKontrolFree" value="0003F" />
    <!--Kode Layanan yg kontrol selanjutnya free, misal kode layanan fisioterapi-->
    <!--=============================================================================================-->
    <!--Kasus di Bali, jika perlakuan sama, samakan dengan default karcis-->
    <add key="KodeKarcisAsingRJ" value="01" />
    <add key="KodeKarcisKitasRJ" value="01" />
    <!--=============================================================================================-->
    <!--Batas periode kontrol berikutknya pasien bpjs-->
    <add key="PeriodeHariKontrolBpjs" value="0" />
    <!--Finger Bpjs App Automation-->
    <add key="IntegrasiFingerBpjs" value="1" />
    <!--1: enable, 0: disable-->
    <add key="FingerscanWaitTimeout" value="30" />
    <!--waktu tunggu scan finger: satuan detik-->
    <add key="FingerAppUserName" value="cicifitria" />
    <!--disesuaikan untuk masing2 rs-->
    <add key="FingerAppPasswd" value="Sakina77?" />
    <!--disesuaikan untuk masing2 rs-->
    <add key="FingerAppExePath" value="" />
    <add key="FristaAppExePath" value="" />
    <!--=============================================================================================-->
    <add key="DebugBpjs" value="1" />
    <!--1: enable, 0: disable-->
    <add key="LogErrorAntrol" value="0" />
    <!--1: enable, 0: disable-->
