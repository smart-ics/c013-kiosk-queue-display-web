    <add key="PrinterLabel" value="PDF Writer - bioPDF" />
    <add key="PrinterSep" value="PDF Writer - bioPDF" />
    <!--HP LaserJet M101-M106-->
    <add key="jumCetakPoli" value="1" />
    <!--diisi dengan bilangan bulat(integer)-->
    <add key="jumCetakSep" value="1" />
    <!--diisi dengan bilangan bulat(integer)-->
    <add key="KeteranganPerawatanSep" value="0" />
    <!--cetak sep include keterangan perawatan RS-->
    <!--=============================================================================================-->
    <add key="RemoteAddresPrinterLabelMR" value="PC-MR;PC-FO;" />
    <!--bisa diisi lebih dari 1 remote address, dipisah ";" (eg. "PC-MR:PC-FO")-->
    <add key="RemoteCetakLabel" value="0" />
    <!-- diisi 1 jika cetak label (via remote cetak)-->
    <add key="RemoteCetakBuktiReg" value="0" />
    <!-- diisi 1 jika cetak bukti registrasi (via remote cetak)-->
    <add key="RemoteCetakSEP" value="0" />
    <!-- diisi 1 jika cetak SEP (via remote cetak)-->
    <add key="RemoteCetakPelayananBPJS" value="0" />
    <!-- diisi 1 jika cetak pelayanan BPJS (via remote cetak)-->
    <add key="RemoteCetakTracert" value="1" />
    <!-- diisi 1 jika cetak tracert (via remote cetak)-->
    <!--=============================================================================================-->
    <add key="CetakAntrianPoliDanDaftar" value="0" />
    <!--dicetak dua-duanya, diisi 1 atau 0 jika cuman salah satu-->
    <add key="HideCetakAntrianManualButton" value="true" />
    <!--default: true, jika ingin tampilkan manual button, value dikosongi -->
    <add key="HidePendaftaranBaruButton" value="" />
    <!--default: dikosongi-->
    <add key="PilihDokter" value="" />
    <!--default: dikosongi, jika tidak ingin ada pilih dokter, isikan "tidak"-->
    <add key="PetunjukNextPasienUmum" value="Ruang Tunggu Poli" />
    <!--Ruang Tunggu Poli, atau diisi tempat yg dituju pasien setelah dari kiosk-->
    <add key="PetunjukNextPasienBPJS" value="Ruang Tunggu Poli" />
    <!--Ruang Tunggu Poli, atau diisi tempat yg dituju pasien setelah dari kiosk-->
    <add key="PetunjukGagalSEP" value="Registrasi" />
    <!--Tempat Create SEP jika gagal create di kiosk-->
