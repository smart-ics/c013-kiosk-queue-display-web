    <add key="PrinterAntrian" value="PDF Writer - bioPDF" />
    <add key="PrinterAntrianLoket" value="PDF Writer - bioPDF" />
    <!--=============================================================================================-->
    <add key="TemplateAntrian" value="0" />
    <!--0 : disable, 1 : enable -> jika cetak menggunakan template C:\ICS\templates\AntrianPoli.btw + C:\ICS\templates\AntrianPendaftaran.btw ) -->
    <add key="CreateCetakSEP" value="1" />
    <!-- diisi 1 untuk create dan cetak sep di kiosk atau 0 jika tidak-->
    <add key="AutoUpdateTglKontrol" value="0" />
    <!-- diisi 1 untuk auto update tgl kontrol skdp jika ada rujukan aktif,  set 0 jika tidak auto update-->
    <!--=============================================================================================-->
    <!--EC-PM-8033-->
    <add key="PrinterDokumen" value="" />
